<Window x:Class="ScreenForge.Windows.BackgroundChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çıktı Seçeneği" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="ChoiceCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A202C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CropSideButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip" Value="Önce alan kırp, sonra bu arka planla dışa aktar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="6,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A202C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,14"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon circle -->
            <Border Grid.RowSpan="2" Width="38" Height="38" CornerRadius="19"
                    Background="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLayers}" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent" Width="24" Height="24" Stretch="Uniform"/>
                </Viewbox>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1" Text="Çıktı Seçeneği"
                       Style="{StaticResource Label}" FontWeight="SemiBold"/>

            <!-- Close button -->
            <Button x:Name="BtnClose" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top"
                    Width="24" Height="24" Cursor="Hand" Margin="6,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                Width="24" Height="24">
                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="24" Height="24" Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Description -->
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Serbest tuval nasıl dışa aktarılsın?"
                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>

            <!-- Buttons: ana seçenek + sağda kırpma -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                <Grid Margin="0,0,0,8" MinHeight="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnOpaque" Style="{StaticResource ChoiceCardButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="7" Background="#263249"
                                    Margin="0,0,12,0">
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconLayers}" Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                          Stretch="Uniform"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Arkaplanlı" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="Mevcut tuval rengiyle çıktı al" Style="{StaticResource Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnOpaqueCrop" Grid.Column="1" Style="{StaticResource CropSideButton}"
                            ToolTip="Kırparak arkaplanlı dışa aktar">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconCrop}" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Kırp" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid MinHeight="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTransparent" Style="{StaticResource ChoiceCardButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="7" Background="#1F2D27"
                                    Margin="0,0,12,0">
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Fill="#EAF0F7"/>
                                    <Rectangle Width="9" Height="9" Fill="#9AA4B8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Rectangle Width="9" Height="9" Fill="#9AA4B8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Saydam" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="PNG olarak saydam çıktı al" Style="{StaticResource Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnTransparentCrop" Grid.Column="1" Style="{StaticResource CropSideButton}"
                            ToolTip="Kırparak saydam dışa aktar">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconCrop}" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Kırp" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
