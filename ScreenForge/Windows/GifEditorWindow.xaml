<Window x:Class="ScreenForge.Windows.GifEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenForge — GIF Düzenleyici"
        Width="1280" Height="820" MinWidth="960" MinHeight="620"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource EditorCanvasBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- İnce, sade kaydırma çubuğu: içeriğe yer bırakır -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" CornerRadius="3" Margin="2"
                                                        Background="#3A4254" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background"
                                                                Value="#556080" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Araç çubuğu düğmesi içeriği: ikon + isteğe bağlı etiket -->
        <Style x:Key="ToolbarIcon" TargetType="Path" BasedOn="{StaticResource EditorIcon}" />

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- başlık çubuğu -->
            <RowDefinition Height="Auto" />
            <!-- araç çubuğu -->
            <RowDefinition Height="*" />
            <!-- tuval + yan panel -->
            <RowDefinition Height="Auto" />
            <!-- zaman çizelgesi -->
            <RowDefinition Height="Auto" />
            <!-- durum çubuğu -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Başlık çubuğu ═══════════ -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="36" Background="{StaticResource EditorChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="GIF Düzenleyici" Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSummary" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="{StaticResource UiFont}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource EditorToolButton}"
                        Width="44" Height="36" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Simge durumuna küçült" />
                <Button x:Name="MaximizeButton" Style="{StaticResource EditorToolButton}"
                        Width="44" Height="36" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Büyüt" />
                <Button x:Name="CloseButton" Style="{StaticResource EditorDangerButton}"
                        Width="46" Height="36" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Kapat (Esc)" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ Araç çubuğu ═══════════ -->
        <Border x:Name="Toolbar" Grid.Row="1" Background="{StaticResource EditorChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="UndoButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Geri al (Ctrl+Z)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUndo}" Style="{StaticResource ToolbarIcon}" />
                                <TextBlock Text="Geri Al" Style="{StaticResource ToolbarLabel}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Yinele (Ctrl+Y)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRedo}" Style="{StaticResource ToolbarIcon}" />
                                <TextBlock Text="Yinele" Style="{StaticResource ToolbarLabel}" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="7,5" />

                        <Button x:Name="DeleteButton" Style="{StaticResource EditorDangerButton}"
                                ToolTip="Seçili kareleri sil (Delete)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource ToolbarIcon}"
                                      Stroke="#FF9A9E" />
                                <TextBlock Text="Sil" Style="{StaticResource ToolbarLabel}" Foreground="#FF9A9E" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DuplicateButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Seçili kareleri çoğalt (Ctrl+D)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDuplicate}" Style="{StaticResource ToolbarIcon}" />
                                <TextBlock Text="Çoğalt" Style="{StaticResource ToolbarLabel}" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="7,5" />

                        <Button x:Name="ReverseButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Kare sırasını tersine çevir">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReverse}" Style="{StaticResource ToolbarIcon}" />
                                <TextBlock Text="Ters Çevir" Style="{StaticResource ToolbarLabel}" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="7,5" />

                        <Button x:Name="RotateLeftButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Sola 90° döndür">
                            <Path Data="{StaticResource IconRotateLeft}" Style="{StaticResource ToolbarIcon}" />
                        </Button>
                        <Button x:Name="RotateRightButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Sağa 90° döndür">
                            <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource ToolbarIcon}" />
                        </Button>
                        <Button x:Name="CropButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Bir alan seçip kırp (Ctrl+Shift+X)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCrop}" Style="{StaticResource ToolbarIcon}" />
                                <TextBlock Text="Kırp" Style="{StaticResource ToolbarLabel}" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="7,5" />

                        <!-- Çizim araçları: seçili katmana uygulanır -->
                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource EditorToolToggle}"
                                      IsChecked="True" ToolTip="Seç ve taşı (V)">
                            <Path Data="{StaticResource IconCursor}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolRect" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Dikdörtgen (R)">
                            <Path Data="{StaticResource IconSquare}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolEllipse" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Elips (E)">
                            <Path Data="{StaticResource IconCircle}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolArrow" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Ok (A)">
                            <Path Data="{StaticResource IconArrow}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolPen" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Kalem (P)">
                            <Path Data="{StaticResource IconPen}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolText" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Metin (T)">
                            <Path Data="{StaticResource IconText}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolStep" Style="{StaticResource EditorToolToggle}"
                                      ToolTip="Adım numarası (S)">
                            <Path Data="{StaticResource IconStep}" Style="{StaticResource ToolbarIcon}" />
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="ExportButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="GIF Kaydet" Padding="16,6" Margin="10,0,0,0" FontSize="12" ToolTip="Ctrl+S" />
            </Grid>
        </Border>

        <!-- ═══════════ Tuval + yan panel ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="308" MinWidth="248" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- Önizleme tuvali -->
            <Grid Grid.Column="0" Background="{StaticResource EditorCanvasBrush}" ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Padding="16">
                    <!-- Border tam olarak görüntü boyutunda kalır; kaplama ve kırpma
                         tuvalleri aynı hücreyi paylaştığı için koordinatlar birebir eşleşir. -->
                    <Border x:Name="CanvasHost" BorderBrush="#33FFFFFF" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="CanvasSurface">
                            <Image x:Name="PreviewImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- Çizim yüzeyi: seçili katmanın sahnesi burada düzenlenir -->
                            <ContentControl x:Name="AnnotationHost" />
                            <!-- Metin düzenlerken yalnızca caret ve seçim görünür; boş alanlar
                                 alttaki çizim tuvaline fare olaylarını geçirmeye devam eder. -->
                            <Canvas x:Name="TextEditLayer" ClipToBounds="True" />
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" ClipToBounds="True" />
                            <Canvas x:Name="CropCanvas" Visibility="Collapsed" Background="#01000000"
                                    Cursor="Cross" ClipToBounds="True" />
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Seçili nesnenin özellikleri: tuvalin altında belirir -->
                <Border x:Name="ObjectProperties" Visibility="Collapsed" VerticalAlignment="Bottom"
                        HorizontalAlignment="Center" Margin="0,0,0,14" CornerRadius="8"
                        Background="#F21A1F2C" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="10,7">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.55" Color="Black" />
                    </Border.Effect>
                    <StackPanel x:Name="ObjectPropertyPanel" Orientation="Horizontal" />
                </Border>

                <!-- Kısa bildirim: yapılan işlemi doğrular. Köşede durur ki
                     tuvalin ortasındaki içeriği ve özellik panelini kapatmasın. -->
                <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Top"
                        HorizontalAlignment="Right" Margin="0,14,18,0" CornerRadius="6"
                        Background="#F2161B28" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" Padding="13,7" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="11.5" />
                </Border>

                <!-- Boş durum -->
                <TextBlock x:Name="EmptyHint" Text="Kare yok"
                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <!-- Kırpma ipucu -->
                <Border x:Name="CropHint" Visibility="Collapsed" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="0,14,0,0" CornerRadius="8"
                        Background="#E60E1118" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CropHintText" Text="Kırpılacak alanı sürükleyerek seçin"
                                   Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   VerticalAlignment="Center" />
                        <Button x:Name="CropApplyButton" Content="Uygula" Margin="14,0,0,0"
                                Style="{StaticResource PrimaryButton}" Padding="12,4" FontSize="11" />
                        <Button x:Name="CropCancelButton" Content="İptal" Margin="4,0,0,0"
                                Style="{StaticResource EditorToolButton}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" />

            <!-- Yan panel -->
            <Border Grid.Column="2" Background="{StaticResource EditorPanelBrush}">
                <TabControl x:Name="SidePanel" Style="{StaticResource SettingsTab}" Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Dışa Aktar" Style="{StaticResource SettingsTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ExportPanel" Margin="12,10" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Kare" Style="{StaticResource SettingsTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FramePanel" Margin="12,10" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Kaplama" Style="{StaticResource SettingsTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OverlayPanel" Margin="12,10" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ═══════════ Zaman çizelgesi ═══════════ -->
        <Grid Grid.Row="3" Background="{StaticResource EditorChromeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Oynatma denetimleri -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FirstFrameButton" Style="{StaticResource EditorTransportButton}"
                                ToolTip="İlk kare (Home)">
                            <Path Data="{StaticResource IconFirstFrame}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" Fill="{StaticResource TextBrush}" />
                        </Button>
                        <Button x:Name="PrevFrameButton" Style="{StaticResource EditorTransportButton}"
                                ToolTip="Önceki kare (←)">
                            <Path Data="{StaticResource IconPrevFrame}" Style="{StaticResource EditorIcon}"
                                  Width="13" Height="13" Fill="{StaticResource TextBrush}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource EditorTransportButton}"
                                ToolTip="Oynat / Duraklat (Boşluk)">
                            <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}"
                                  Style="{StaticResource EditorIcon}" Width="15" Height="15"
                                  Fill="{StaticResource AccentBrush}" Stroke="{StaticResource AccentBrush}" />
                        </Button>
                        <Button x:Name="NextFrameButton" Style="{StaticResource EditorTransportButton}"
                                ToolTip="Sonraki kare (→)">
                            <Path Data="{StaticResource IconNextFrame}" Style="{StaticResource EditorIcon}"
                                  Width="13" Height="13" Fill="{StaticResource TextBrush}" />
                        </Button>
                        <Button x:Name="LastFrameButton" Style="{StaticResource EditorTransportButton}"
                                ToolTip="Son kare (End)">
                            <Path Data="{StaticResource IconLastFrame}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" Fill="{StaticResource TextBrush}" />
                        </Button>

                        <CheckBox x:Name="LoopCheck" Content="Döngü" IsChecked="True" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                  FontFamily="{StaticResource UiFont}" FontSize="11" />
                    </StackPanel>

                    <!-- Aralık işaretleri -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="MarkInButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Aralık başlangıcını buraya taşı (I)">
                            <Path Data="{StaticResource IconMarkIn}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" />
                        </Button>
                        <TextBlock x:Name="RangeLabel" Style="{StaticResource EditorFieldLabel}" Margin="8,0" />
                        <Button x:Name="MarkOutButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Aralık bitişini buraya taşı (O)">
                            <Path Data="{StaticResource IconMarkOut}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" />
                        </Button>
                        <Button x:Name="TrimButton" Style="{StaticResource EditorToolButton}"
                                Content="Aralığı Uygula" Margin="8,0,0,0" ToolTip="Aralık dışındaki kareleri sil" />
                        <Button x:Name="RangeResetButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Aralığı sıfırla">
                            <Path Data="{StaticResource IconReset}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Yakınlaştırma -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="ZoomSlider" Width="104" Minimum="10" Maximum="400" Value="100"
                                Style="{StaticResource ToolSlider}" VerticalAlignment="Center"
                                ToolTip="Yakınlaştırma — Ctrl + fare tekerleği" />
                        <TextBlock x:Name="ZoomLabel" Style="{StaticResource EditorFieldLabel}"
                                   Width="40" Margin="8,0,0,0" />
                        <Button x:Name="ZoomFitButton" Style="{StaticResource EditorToolButton}"
                                ToolTip="Pencereye sığdır (Ctrl+0)">
                            <Path Data="{StaticResource IconFit}" Style="{StaticResource EditorIcon}"
                                  Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Kare şeridi. Soldaki 150px boşluk klip adları sütunuyla aynı
                 genişliktedir; böylece kareler ve klipler tam alt alta durur. -->
            <ListBox x:Name="Timeline" Grid.Row="1" Height="104" Margin="150,0,0,0"
                     Background="{StaticResource EditorCanvasBrush}"
                     BorderThickness="0" SelectionMode="Extended" Focusable="True"
                     ItemContainerStyle="{StaticResource EditorFrameItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem x:Name="MenuDuplicate" Header="Çoğalt" InputGestureText="Ctrl+D"
                                  Style="{StaticResource DarkMenuItem}" />
                        <MenuItem x:Name="MenuDelete" Header="Sil" InputGestureText="Delete"
                                  Style="{StaticResource DarkMenuItem}" />
                        <Separator Style="{StaticResource DarkSeparator}" />
                        <MenuItem x:Name="MenuMoveLeft" Header="Sola taşı" InputGestureText="Ctrl+Alt+←"
                                  Style="{StaticResource DarkMenuItem}" />
                        <MenuItem x:Name="MenuMoveRight" Header="Sağa taşı" InputGestureText="Ctrl+Alt+→"
                                  Style="{StaticResource DarkMenuItem}" />
                        <Separator Style="{StaticResource DarkSeparator}" />
                        <MenuItem x:Name="MenuDeleteBefore" Header="Öncekileri sil" InputGestureText="Alt+←"
                                  Style="{StaticResource DarkMenuItem}" />
                        <MenuItem x:Name="MenuDeleteAfter" Header="Sonrakileri sil" InputGestureText="Alt+→"
                                  Style="{StaticResource DarkMenuItem}" />
                        <Separator Style="{StaticResource DarkSeparator}" />
                        <MenuItem x:Name="MenuMarkIn" Header="Aralık başlangıcı" InputGestureText="I"
                                  Style="{StaticResource DarkMenuItem}" />
                        <MenuItem x:Name="MenuMarkOut" Header="Aralık bitişi" InputGestureText="O"
                                  Style="{StaticResource DarkMenuItem}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" IsVirtualizing="True"
                                                VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Kare işlemleri karenin kendisinde: fareyle üzerine
                             gelince çoğalt/sil düğmeleri belirir. -->
                        <Grid x:Name="Root" Width="78" Margin="2" Background="Transparent">
                            <StackPanel>
                                <Border x:Name="Thumb" CornerRadius="3" ClipToBounds="True" Height="54"
                                        Background="#0D1017" BorderBrush="Transparent" BorderThickness="0">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Number}" FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource UiFont}" />
                                    <TextBlock Text="{Binding DelayText}" FontSize="9.5" Margin="5,0,0,0"
                                               Foreground="#5B6880" FontFamily="{StaticResource UiFont}" />
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="Actions" VerticalAlignment="Top" HorizontalAlignment="Center"
                                    Margin="0,3,0,0" CornerRadius="4" Background="#E00E1118"
                                    Opacity="0" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FrameChipButton}"
                                            Tag="{Binding}" Click="FrameDuplicate_Click"
                                            ToolTip="Bu kareyi çoğalt">
                                        <Path Data="{StaticResource IconDuplicate}"
                                              Style="{StaticResource EditorIcon}" Width="12" Height="12" />
                                    </Button>
                                    <Button Style="{StaticResource FrameChipButton}"
                                            Tag="{Binding}" Click="FrameDelete_Click"
                                            ToolTip="Bu kareyi sil">
                                        <Path Data="{StaticResource IconTrash}"
                                              Style="{StaticResource EditorIcon}" Width="12" Height="12"
                                              Stroke="#FF9A9E" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True" />
                            </Trigger>

                            <!-- Çoğaltılan kare: kaynağından ayırt edilsin -->
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter TargetName="Thumb" Property="BorderBrush" Value="#5BC8F5" />
                                <Setter TargetName="Thumb" Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ═══ Nesne şeridi: karelerle hizalı klipler ═══ -->
            <Border x:Name="ClipStrip" Grid.Row="2" Visibility="Collapsed"
                    Background="{StaticResource EditorCanvasBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MaxHeight="118" />
                    </Grid.RowDefinitions>

                    <!-- Kare komutları -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="8,2">
                            <TextBlock Text="Bu kare:" Style="{StaticResource EditorFieldLabel}"
                                       Margin="0,0,5,0" />
                            <TextBlock x:Name="FrameObjectsLabel" Style="{StaticResource EditorFieldLabel}"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" />

                            <Button x:Name="ClearFrameButton" Content="Temizle"
                                    Style="{StaticResource EditorDangerButton}"
                                    ToolTip="Bu karedeki nesneleri kaldır" />
                        </StackPanel>
                    </Border>

                    <!-- Nesne adları -->
                    <ScrollViewer x:Name="ClipLabelScroll" Grid.Row="1" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ClipRows" Margin="8,2,4,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Row" Height="18" Background="Transparent"
                                          MouseLeftButtonDown="ClipRowSelect_Click" Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}"
                                                  VerticalAlignment="Center" ToolTip="Göster / gizle"
                                                  RenderTransformOrigin="0.5,0.5">
                                            <CheckBox.RenderTransform>
                                                <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                                            </CheckBox.RenderTransform>
                                        </CheckBox>

                                        <!-- Nesnenin şeritteki rengi -->
                                        <Rectangle Grid.Column="1" Width="3" Height="11" Margin="5,0,0,0"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="{Binding Swatch}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Label}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource UiFont}" />
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground"
                                                    Value="{StaticResource TextBrush}" />
                                            <Setter TargetName="Row" Property="Background" Value="#1C2130" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Klipler: kare şeridiyle aynı ölçek ve kaydırma -->
                    <ScrollViewer x:Name="ClipScroll" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#0D1017">
                        <Canvas x:Name="ClipCanvas" HorizontalAlignment="Left" MinHeight="18" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Durum çubuğu ═══════════ -->
        <Border Grid.Row="4" Background="#0F121C" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Height="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusLabel" Margin="12,0" VerticalAlignment="Center"
                           Style="{StaticResource EditorFieldLabel}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatsLabel" Style="{StaticResource EditorFieldLabel}" />
                    <TextBlock x:Name="EstimateLabel" Style="{StaticResource EditorFieldLabel}"
                               Margin="14,0,0,0" ToolTip="Kaba tahmin — gerçek boyut içeriğe göre değişir" />
                </StackPanel>

                <ProgressBar x:Name="ExportProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                             Visibility="Collapsed" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}" Background="#222A3A" />

                <!-- Uzun süren düzenlemelerde belirsiz ilerleme -->
                <ProgressBar x:Name="BusyBar" Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                             Visibility="Collapsed" BorderThickness="0" IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}" Background="#222A3A" />
            </Grid>
        </Border>
    </Grid>
</Window>
